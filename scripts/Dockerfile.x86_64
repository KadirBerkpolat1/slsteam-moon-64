# Builder image for the x86_64 (steamrt64) build.
#
# Why 24.04 and not 22.04: the source is C++20, and under C++20 glibc's own
# headers redirect strtol/strtoul/strtoll/strtoull to the __isoc23_* variants,
# which first shipped in glibc 2.38. Nothing in this fork calls strtol directly,
# it arrives through <cstdlib>, so there is no source-level way to opt out.
# Ubuntu 22.04's glibc 2.35 therefore cannot link it, and libstdc++ there is
# also too old for GLIBCXX_3.4.32 (ios_base_library_init, gcc 13+).
#
# Ubuntu 24.04 supplies glibc 2.39 and gcc 13. The resulting SLSsteam.so
# requires GLIBC_2.38 and GLIBCXX_3.4.32, which is the honest floor:
#   Debian 13 (2.41)      ok
#   Ubuntu 24.04 (2.39)   ok
#   Fedora 39+ (2.38)     ok
#   Arch / CachyOS        ok (rolling)
#   Ubuntu 22.04 (2.35)   NO -- build natively with scripts/build.sh --host instead
#   Debian 12 (2.36)      NO -- same
FROM ubuntu:24.04

# 64-bit only: no i386 multilib, no lib32 pkg-config.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get \
        -o Dpkg::Options::="--force-overwrite" \
        install -y --no-install-recommends \
        ca-certificates \
        g++ \
        libcurl4-openssl-dev \
        libssl-dev \
        make \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
